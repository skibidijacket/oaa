-- Обёртка: подменяет текст спама на пробел, не ломая работу чита.
-- Vortex Hub загружается оригинальным, без изменений.

local SG = game:GetService("StarterGui")
local LP = game:GetService("Players").LocalPlayer
local SPAM = {"loaded","hub","ftap","vortex","inject","cheat","exploit","made by","script","загружен","запущен","успешно"}

local function isSpam(t)
	if type(t) ~= "string" then return false end
	t = t:lower()
	for _, w in ipairs(SPAM) do
		if t:find(w, 1, true) then return true end
	end
	return false
end

local mt = getrawmetatable(game)
local old = mt.__namecall
setreadonly(mt, false)
mt.__namecall = newcclosure(function(self, ...)
	local m = getnamecallmethod()
	local args = {...}
	
	-- Не блокируем вызов! Просто подменяем текст на пробел.
	if m == "SendAsync" and typeof(self) == "Instance" and self:IsA("TextChannel") then
		if isSpam(args[1]) then args[1] = " " end
	elseif m == "SetCore" and (self == SG or self == game:GetService("CoreGui")) then
		if args[1] == "ChatMakeSystemMessage" and type(args[2]) == "table" and isSpam(args[2].Text) then
			args[2].Text = " "
		end
	end
	
	-- Вызываем оригинал с (возможно) изменёнными аргументами
	return old(self, table.unpack(args))
end)
setreadonly(mt, true)

